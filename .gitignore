# ==========================================
# Git Ignore - Estrutura reorganizada
# ==========================================

# 1. Datasets pesados e dados brutos
data/raw/
*.csv
*.tsv
*.zip
*.tar.gz

# 2. Dados processados (gerados pelos scripts)
data/processed/

# 3. Gráficos gerados
data/figuras/

# 4. Ambiente Python e Cache
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.uv/

# 5. Checkpoints do Jupyter
.ipynb_checkpoints/

# 6. Documentos compilados (LaTeX, PDF)
docs/relatorio_eda.tex
docs/estrutura-eda.md
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.pdf

# 7. Configurações de IDE e SO
.DS_Store
.vscode/
.idea/

# 8. Ferramentas e Temporários
.agents/
temp/
scratch/
